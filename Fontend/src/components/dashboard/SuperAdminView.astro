---
interface Props {
  data: any;
}

const { data } = Astro.props;
---

<div
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 text-cyan-500"
>
  <div
    class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-blue-500 text-bold"
  >
    <h3>Carreras</h3><p class="text-2xl">${data.carreras?.length || 0}</p>
  </div>
  <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-green-500">
    <h3>Cursos</h3><p>${data.cursos?.length || 0}</p>
    <button
      class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded mt-2 m-auto active:{group}"
      >Ver Cursos</button
    >
    <div class="hidden group-active:block">
      {
        data.cursos?.map((curso: any) => (
          <div key={curso.id}>
            <p>${curso.nombre}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-yellow-500">
    <h3>Unidades</h3><p>${data.unidades?.length || 0}</p>
  </div>
  <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-purple-500">
    <h3>Usuarios</h3><p>${data.usuarios?.length || 0}</p>
  </div>
  <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-purple-500">
    <h3>Tickets</h3><p>${data.tickets?.length || 0}</p>
  </div>
</div>
<div id="superadmin-view"></div>
