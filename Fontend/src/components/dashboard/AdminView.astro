---
interface Props {
  data: any;
}

const { data } = Astro.props;
---

<div class="p-6">
  <h2 class="text-2xl font-bold mb-4">Panel de Administrador</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-bold text-gray-500">Cursos</h3>
      <p class="text-2xl">{data.cursos?.length || 0}</p>
    </div>
    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-bold text-gray-500">Unidades</h3>
      <p class="text-2xl">{data.unidades?.length || 0}</p>
    </div>
    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-bold text-gray-500">Maestros</h3>
      <p class="text-2xl">{data.maestros?.length || 0}</p>
    </div>
  </div>

  <div class="bg-white rounded shadow p-6">
    <h3 class="text-xl font-bold mb-4">Gestión de Carrera</h3>
    <p class="text-gray-600">
      Gestiona los cursos y maestros de tu carrera asignada.
    </p>
  </div>
</div>
