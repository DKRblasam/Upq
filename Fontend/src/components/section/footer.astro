---
// Footer.astro
---

<footer
  class="bg-[#0d0d1a] text-gray-300 py-12 px-6 border-t-4 border-yellow-500"
>
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Logo y descripción -->
      <div class="lg:col-span-1">
        <div class="flex items-center mb-6">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mr-2 shadow-lg shadow-blue-500/20">
            <span class="text-white font-bold text-xl">Study</span>
          </div>
          <div
            class="w-12 h-12 rounded-lg bg-yellow-500 flex items-center justify-center mr-4 shadow-lg shadow-blue-500/20"
          >
            <span class="text-black font-bold text-xl">hub</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-1">Tablón Digital </h3>
            <p
              class="text-xs text-yellow-500 font-semibold tracking-wider uppercase"
            >
              Universidad Politécnica
            </p>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Plataforma integral para la gestión académica y comunicación
          institucional. Conectando a la comunidad universitaria.
        </p>

        <!-- Redes sociales -->
        <div class="flex space-x-4">
          <a
            href="#"
            class="w-10 h-10 rounded-lg bg-gray-800 hover:bg-blue-600 text-gray-400 hover:text-white transition-all duration-300 flex items-center justify-center border border-gray-700 hover:border-blue-500"
          >
            <i class="fab fa-facebook-f"></i>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-lg bg-gray-800 hover:bg-pink-600 text-gray-400 hover:text-white transition-all duration-300 flex items-center justify-center border border-gray-700 hover:border-pink-500"
          >
            <i class="fab fa-instagram"></i>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-lg bg-gray-800 hover:bg-blue-400 text-gray-400 hover:text-white transition-all duration-300 flex items-center justify-center border border-gray-700 hover:border-blue-300"
          >
            <i class="fab fa-twitter"></i>
          </a>
        </div>
      </div>

      <!-- Enlaces Rápidos -->
      <div>
        <h4
          class="text-lg font-bold text-white mb-6 border-b-2 border-yellow-500 inline-block pb-1"
        >
          Navegación
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/"
              class="text-gray-400 hover:text-yellow-400 transition-colors duration-200 text-sm flex items-center"
            >
              <i class="fas fa-chevron-right text-xs mr-2 text-blue-500"></i> Inicio
            </a>
          </li>
          <li>
            <a
              href="/login"
              class="text-gray-400 hover:text-yellow-400 transition-colors duration-200 text-sm flex items-center"
            >
              <i class="fas fa-chevron-right text-xs mr-2 text-blue-500"></i> Acceso
              Alumnos
            </a>
          </li>
          <li>
            <a
              href="/dashboard"
              class="text-gray-400 hover:text-yellow-400 transition-colors duration-200 text-sm flex items-center"
            >
              <i class="fas fa-chevron-right text-xs mr-2 text-blue-500"></i> Acceso
              Docentes
            </a>
          </li>
          <li>
            <a
              href="#"
              class="text-gray-400 hover:text-yellow-400 transition-colors duration-200 text-sm flex items-center"
            >
              <i class="fas fa-chevron-right text-xs mr-2 text-blue-500"></i> Calendario
              Escolar
            </a>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h4
          class="text-lg font-bold text-white mb-6 border-b-2 border-yellow-500 inline-block pb-1"
        >
          Contacto
        </h4>
        <ul class="space-y-4">
          <li class="flex items-start space-x-3">
            <i class="fas fa-map-marker-alt mt-1 text-blue-500"></i>
            <span class="text-gray-400 text-sm">
              Carretera Estatal 420 S/N,<br />
              El Marqués, Querétaro.
            </span>
          </li>
          <li class="flex items-center space-x-3">
            <i class="fas fa-phone-alt text-blue-500"></i>
            <span class="text-gray-400 text-sm">+52 (442) 101 9000</span>
          </li>
          <li class="flex items-center space-x-3">
            <i class="fas fa-envelope text-blue-500"></i>
            <span class="text-gray-400 text-sm">contacto@upq.edu.mx</span>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4
          class="text-lg font-bold text-white mb-6 border-b-2 border-yellow-500 inline-block pb-1"
        >
          Boletín
        </h4>
        <p class="text-gray-400 text-sm mb-4">
          Suscríbete para recibir noticias y avisos importantes.
        </p>
        <form class="flex flex-col gap-3">
          <input
            type="email"
            placeholder="Tu correo institucional"
            class="bg-gray-800 border border-gray-700 text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 placeholder-gray-500"
          />
          <button
            type="button"
            class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 transition-colors"
          >
            Suscribirse
          </button>
        </form>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-800 pt-8 mt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <p class="text-gray-500 text-sm mb-4 md:mb-0 text-center md:text-left">
          © 2024 Universidad Politécnica de Querétaro. <br
            class="md:hidden"
          />Todos los derechos reservados.
        </p>
        <div class="flex space-x-6 text-sm">
          <a href="/policy" class="text-gray-500 hover:text-white transition-colors"
            >Política de Privacidad</a
          >
          <a href="/terms" class="text-gray-500 hover:text-white transition-colors"
            >Términos</a
          >
          <a href="/cookies" class="text-gray-500 hover:text-white transition-colors"
            >Política de Cookies</a
          >
          <a href="/support" class="text-gray-500 hover:text-white transition-colors"
            >Soporte</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- FontAwesome CDN (si no está ya en el layout) -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
/>
