---
const { isnessery } = Astro.props;

if (!isnessery) {
  
}

---

<header
  class="flex flex-col md:flex-row justify-between items-start md:items-center px-5 md:px-8 py-4 bg-[#0d0d1a] gap-4"
>
  <div class="flex items-center mb-4 md:mb-0 bg-blue-600">
    <div
      class="bg-yellow-500 rounded-lg p-3 mr-4 flex items-center justify-center"
    >
      <i class="fas fa-graduation-cap text-[#1a1a2e] text-2xl"></i>
    </div>
    <div class="flex flex-col">
      <span class="text-xl font-bold text-gray-100">UPQ - TIID</span>
      <span class="text-[13px] text-gray-400 mt-0.5"
        >Tecnologías de la Información e Innovación Digital</span
      >
    </div>
  </div>
  

  <div
    id="customer"
    class="flex items-center w-full md:w-auto justify-between md:justify-start gap-2 md:gap-3"
  >
    <button
      class="teacher-access-btn bg-red-500 text-[#1a1a2e] rounded-lg px-5 py-3 text-[15px] font-semibold cursor-pointer flex items-center justify-center hover:bg-yellow-600 transition-colors w-[48%] md:w-auto"
    >
      <i class="fas fa-arrow-right mr-2"></i>
      Acceso Profesores
    </button>
    <button
      class="bg-blue-600 text-white rounded-lg px-4 py-3 cursor-pointer flex items-center justify-center hover:bg-green-700 transition-colors w-[48%] md:w-auto"
    >
      <i class="fas fa-pencil-alt"></i>
    </button>
  </div>
</header>
