---
import Layout from "@lyt/Layout.astro";
import "@sty/global.css";

import "@sty/card.css";

---

<link rel="stylesheet" href="@sty/card.css">


<Layout title="añameno">
  <main class="flex w-full h-screen justify-center items-center box-border">
    <div class="box h-[620px]">
      <span class="borderLine"></span>
      <form action="autenticacion.php" method="POST">
        <h2>Crear Cuenta</h2>

        <!-- Input Matricula -->
        <div class="relative">
          <input
            type="text"
            name="Matricula"
            required
            id="Matricula"
            placeholder=" "
            class="peer w-full px-3 pt-5 pb-2 text-white bg-transparent border-b-2 border-gray-600 focus:border-cyan-400 focus:outline-none rounded-sm"
          />
          <label
            for="Matricula"
            class="absolute left-3 top-2 text-gray-400 text-sm duration-300 transform -translate-y-1/2 scale-100
                   peer-placeholder-shown:translate-y-5 peer-placeholder-shown:scale-100
                   peer-focus:-translate-y-1/2 peer-focus:text-cyan-400"
          >
            Matrícula
          </label>
        </div>

        <!-- Input Nombre -->
        <div class="relative mt-4 mb-4">
          <input
            type="text"
            name="Nombre"
            required
            id="Nombre"
            placeholder=" "
            class="peer w-full px-3 pt-5 pb-2 text-white bg-transparent border-b-2 border-gray-600 focus:border-pink-400 focus:outline-none rounded-sm"
          />
          <label
            for="Nombre"
            class="absolute left-3 top-2 text-gray-400 text-sm duration-300 transform -translate-y-1/2 scale-100
                   peer-placeholder-shown:translate-y-5 peer-placeholder-shown:scale-100
                   peer-focus:-translate-y-1/2 peer-focus:text-pink-400"
          >
            Nombre
          </label>
        </div>

        <!-- Input contraseña -->
        <div class="relative mt-4 mb-4">
          <input
            type="password"
            name="Contraseña"
            required
            id="Contraseña"
            placeholder=" "
            class="peer w-full px-3 pt-5 pb-2 text-white bg-transparent border-b-2 border-gray-600 focus:border-cyan-400 focus:outline-none rounded-sm"
          />
          <label
            for="Contraseña"
            class="absolute left-3 top-2 text-gray-400 text-sm duration-300 transform -translate-y-1/2 scale-100
                   peer-placeholder-shown:translate-y-5 peer-placeholder-shown:scale-100
                   peer-focus:-translate-y-1/2 peer-focus:text-cyan-400"
          >
            Contraseña
          </label>
        </div>

        <!-- Input confirmar contraseña -->
        <div class="relative mt-4 mb-4">
          <input
            type="password"
            name="Confirmar_Contraseña"
            required
            id="Confirmar_Contraseña"
            placeholder=" "
            class="peer w-full px-3 pt-5 pb-2 text-white bg-transparent border-b-2 border-gray-600 focus:border-pink-400 focus:outline-none rounded-sm"
          />
          <label
            for="Confirmar_Contraseña"
            class="absolute left-3 top-2 text-gray-400 text-sm duration-300 transform -translate-y-1/2 scale-100
                   peer-placeholder-shown:translate-y-5 peer-placeholder-shown:scale-100
                   peer-focus:-translate-y-1/2 peer-focus:text-pink-400"
          >
            Confirmar Contraseña
          </label>
        </div>

        <!-- Input codigo super secreto -->
        <div class="relative mt-4 mb-4">
          <input
            type="text"
            name="Codigo_Super_Secreto"
            required
            id="Codigo_Super_Secreto"
            placeholder=" "
            class="peer w-full px-3 pt-5 pb-2 text-white bg-transparent border-b-2 border-gray-600 focus:border-cyan-400 focus:outline-none rounded-sm"
          />
          <label
            for="Codigo_Super_Secreto"
            class="absolute left-3 top-2 text-gray-400 text-sm duration-300 transform -translate-y-1/2 scale-100
                   peer-placeholder-shown:translate-y-5 peer-placeholder-shown:scale-100
                   peer-focus:-translate-y-1/2 peer-focus:text-cyan-400"
          >
            Codigo Super Secreto
          </label>
        </div>

        <!-- Enlace para login -->
        <div class="links">
          <a href="/pru">Ya tengo cuenta</a>
        </div>

        <!-- Botón para iniciar sesión -->
        <input type="submit" value="Ingresar" />
      </form>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById("loginForm") as HTMLFormElement;
  const errorMessage = document.getElementById("errorMessage");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorMessage) errorMessage.classList.add("hidden");

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    console.log(data);

    try {
      const response = await fetch("http://localhost:4000/api/auth/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (result.success) {
        // Guardar token y usuario
        localStorage.setItem("token", result.data.token);
        localStorage.setItem("user", JSON.stringify(result.data.user));

        // Redireccionar
        // window.location.href = "";
      } else {
        if (errorMessage) {
          errorMessage.textContent =
            result.error || "Error al iniciar sesión";
          errorMessage.classList.remove("hidden");
        }
      }
    } catch (error) {
      console.error("Error:", error);
      if (errorMessage) {
        errorMessage.textContent = "Error de conexión con el servidor";
        errorMessage.classList.remove("hidden");
      }
    }
  });
</script>

