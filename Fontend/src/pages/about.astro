---
import Layout from "@lyt/Layout.astro";
import Header from "@/components/section/header.astro";
import Footer from "@/components/section/footer.astro";
---

<Layout title="Sobre Nosotros - UPQ">
  <Header />
  <main class="bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-blue-900 text-white py-20">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Sobre Nosotros</h1>
        <p class="text-xl text-blue-200">
          Universidad Politécnica de Querétaro
        </p>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="py-16 max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12">
        <div
          class="bg-white p-8 rounded-xl shadow-md border-t-4 border-yellow-500"
        >
          <div
            class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mb-4"
          >
            <i class="fas fa-bullseye text-yellow-600 text-xl"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-4">Misión</h2>
          <p class="text-gray-600 leading-relaxed">
            Formar profesionales competentes a través de programas educativos de
            calidad, con un modelo basado en competencias, vinculación con el
            sector productivo y una formación integral que contribuya al
            desarrollo tecnológico y social.
          </p>
        </div>

        <div
          class="bg-white p-8 rounded-xl shadow-md border-t-4 border-blue-500"
        >
          <div
            class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-4"
          >
            <i class="fas fa-eye text-blue-600 text-xl"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-4">Visión</h2>
          <p class="text-gray-600 leading-relaxed">
            Ser una institución reconocida nacional e internacionalmente por la
            calidad de sus egresados, su investigación aplicada y su
            contribución al desarrollo sostenible de la región.
          </p>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="bg-white py-16">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-12 group">
          Nuestros Valores
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center text-gray-800">
          <div class="p-4 group">
            <i class="fas fa-hand-holding-heart text-4xl text-blue-600 mb-4"
            ></i>
            <h3 class="font-bold text-lg group-hover:text-yellow-500">Responsabilidad</h3>
          </div>
          <div class="p-4 group">
            <i class="fas fa-balance-scale text-4xl text-blue-600 mb-4"></i>
            <h3 class="font-bold text-lg group-hover:text-red-500">Honestidad</h3>
          </div>
          <div class="p-4 group">
            <i class="fas fa-users text-4xl text-blue-600 mb-4"></i>
            <h3 class="font-bold text-lg group-hover:text-cyan-600">Respeto</h3>
          </div>
          <div class="p-4 group">
            <i class="fas fa-lightbulb text-4xl text-blue-600 mb-4"></i>
            <h3 class="font-bold text-lg group-hover:text-green-500">Innovación</h3>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
