---
// Dashboard.astro
import Layout from "../layouts/Layout.astro";
import Header from "@/components/section/header.astro";
import SuperAdminView from "@/components/dashboard/SuperAdminView.astro";

let user = null;
let data = null;
let loading = true;
---

<script is:inline>
  document.addEventListener("DOMContentLoaded", async () => {
    const token = localStorage.getItem("token");
    const userStr = localStorage.getItem("user");

    if (!token || !userStr) {
      window.location.href = "/login";
      return;
    }

    user = JSON.parse(userStr);

    if (user.rol === "user") {
      alert("No tienes acceso al dashboard.");
      window.location.href = "/";
      return;
    }

    try {
      const res = await fetch("http://localhost:4000/api/dashboard/data", {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (!res.ok) throw new Error("Error al cargar datos");

      data = await res.json();
      document.getElementById("loading").classList.add("hidden");
      document.getElementById("dashboard-content").classList.remove("hidden");
      renderDashboard(user, data);
    } catch (e) {
      console.error(e);
      localStorage.removeItem("token");
      localStorage.removeItem("user");
      window.location.href = "/login";
    }
  });

  function renderDashboard(user, data) {
    const viewContainer = document.getElementById("view-container");
    let html = "";

    if (user.rol === "Superadm") {
      html = `
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 text-cyan-500">
          <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-blue-500 text-bold">
            <h3>Carreras</h3><p class="text-2xl">${data.carreras?.length || 0}</p>
          </div>
          <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-green-500">
            <h3>Cursos</h3><p>${data.cursos?.length || 0}</p>
            <button class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded mt-2 m-auto active:{group}">Ver Cursos</button>
            <div class="hidden group-active:block">
              
            </div>
          </div>
          <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-yellow-500">
            <h3>Unidades</h3><p>${data.unidades?.length || 0}</p>
          </div>
          <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-purple-500">
            <h3>Usuarios</h3><p>${data.usuarios?.length || 0}</p>
          </div>
          <div class="bg-[#0d0d1a] p-4 rounded shadow border-l-4 border-purple-500">
            <h3>Tickets</h3><p>${data.tickets?.length || 0}</p>
          </div>
        </div>
        <div id="superadmin-view"></div>
      `;
    }

    viewContainer.innerHTML = html;
  }
</script>

<Layout title="Dashboard" descripcion="Dashboard">
  <Header showbtnlogin={false} />

  
  <main class="min-h-screen p-4">
    <div id="loading" class="flex justify-center items-center h-64">
      <p class="text-xl text-gray-700">Cargando dashboard...</p>
    </div>
    <div id="dashboard-content" class="hidden max-w-7xl mx-auto">
      <div class="bg-[#0d0d1a] shadow rounded-lg p-6 mb-6">
        <h1 id="welcome-msg" class="text-3xl font-bold text-gray-100">
          Bienvenido
        </h1>
        <p id="role-msg" class="text-gray-800 mt-2"></p>
      </div>
      <div id="view-container"></div>
    </div>
  </main>
</Layout>
