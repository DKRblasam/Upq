// componentes
import Layout from "@lyt/Layout.astro";
import LiteYouTube from "@/components/elements/LiteYouTube.astro";
import SectionTitle from "@/components/elements/SectionTitle.astro";
---

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
/>

<main class="px-5 md:px-8 py-10 max-w-6xl mx-auto">
  <!-- Subjects Section -->
  <section class="mb-16">
    <h2 class="text-3xl md:text-4xl font-bold mb-8 text-gray-100">
      Materias Disponibles — {currentCareer.name} / Cuatrimestre {
        currentQuarter.number
      }
    </h2>

    <div class="flex flex-wrap gap-4">
      <button
        class="subject-tag bg-yellow-500 text-[#1a1a2e] rounded-lg px-5 py-3 cursor-pointer transition-colors flex items-center font-semibold"
        data-materia="all"
      >
        <i class="fas fa-book-open mr-2"></i>
        Todas las Materias
      </button>

      {
        currentQuarter.materias.map((materia) => (
          <button
            class="subject-tag bg-[#28283f] text-gray-100 rounded-lg px-5 py-3 cursor-pointer hover:bg-[#4a4a6b] transition-colors flex items-center"
            data-materia={materia.name}
          >
            {materia.name}
          </button>
        ))
      }
    </div>
  </section>

  <!-- Publications Section -->
  <section>
    <h2 class="text-3xl md:text-4xl font-bold mb-8 text-gray-100">
      Todas las Publicaciones
    </h2>

    <div
      class="bg-[#28283f] rounded-xl p-12 text-center flex flex-col items-center justify-center min-h-[300px] max-w-4xl mx-auto subject-content"
      id="subject-content"
    >
      <!-- contenido dinámico aparecerá aquí -->
      <div
        class="bg-yellow-500 rounded-full p-5 mb-6 flex items-center justify-center"
      >
        <i class="fas fa-book text-[#1a1a2e] text-4xl"></i>
      </div>
      <p class="text-2xl font-semibold mb-2 text-gray-100">
        No hay publicaciones aún
      </p>
      <p class="text-base text-gray-400">
        Selecciona una materia para ver el contenido
      </p>
    </div>
  </section>
</main>

<script type="module">
  const materias = JSON.parse(
    String.raw`<!--${JSON.stringify(currentQuarter.materias)}-->`
  );

  const contentBox = document.getElementById("subject-content");

  const subjectTags = document.querySelectorAll(".subject-tag");
  subjectTags.forEach((tag) => {
    tag.addEventListener("click", () => {
      // estilo seleccionado
      subjectTags.forEach((t) => {
        t.classList.remove("bg-yellow-500", "text-[#1a1a2e]", "font-semibold");
        t.classList.add("bg-[#28283f]", "text-gray-100");
      });

      tag.classList.remove("bg-[#28283f]", "text-gray-100");
      tag.classList.add("bg-yellow-500", "text-[#1a1a2e]", "font-semibold");

      const materiaName = tag.dataset.materia;

      if (materiaName === "all") {
        contentBox.innerHTML = `
          <div class="bg-yellow-500 rounded-full p-5 mb-6 flex items-center justify-center">
            <i class="fas fa-book text-[#1a1a2e] text-4xl"></i>
          </div>
          <p class="text-2xl font-semibold mb-2 text-gray-100">Todas las Materias</p>
          <p class="text-base text-gray-400">Selecciona una materia específica para ver su contenido</p>
        `;
        return;
      }

      const materia = materias.find((m) => m.name === materiaName);

      if (!materia || materia.contenidos.length === 0) {
        contentBox.innerHTML = `
          <p class="text-2xl font-semibold mb-2 text-gray-100">Sin contenido</p>
          <p class="text-base text-gray-400">El profesor aún no ha subido materiales</p>
        `;
        return;
      }

      const videosHTML = materia.contenidos
        .map(
          (v) => `
        <section class="max-w-xl px-5 py-10 mx-auto">
          <h3 class="pb-2 text-2xl font-semibold text-gray-100">${v.title}</h3>
          <lite-youtube
            videoid="${v.videoId}"
            playlabel="${v.title}"
            style="background-image:url('${v.backgroundImage}');"
          ></lite-youtube>
        </section>
      `
        )
        .join("");

      contentBox.innerHTML = videosHTML;
    });
  });
</script>
