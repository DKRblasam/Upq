---
import Layout from "@lyt/Layout.astro";
import Footer from "@cmp/section/footer.astro";
---

<Layout title="En Construcción | UPQ" descripcion="">
  <main
    class="flex min-h-screen flex-col items-center justify-center p-4 text-center"
  >
    <div class="relative mb-8">
      <div
        class="absolute -inset-4 rounded-full bg-gradient-to-r from-orange-400 to-red-600 opacity-30 blur-xl animate-pulse"
      >
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="relative h-32 w-32 text-orange-500"
      >
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
        <path d="M12 2L2 22h20L12 2Z" class="hidden"></path>
        <!-- Hidden triangle for structure if needed later, replacing with construction cone metaphor below -->
        <path
          d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
        ></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
    </div>

    <h1
      class="mb-4 text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
    >
      <span
        class="bg-gradient-to-r from-orange-500 to-red-600 bg-clip-text text-transparent"
      >
        En Construcción
      </span>
    </h1>

    <p class="mb-8 max-w-lg text-lg text-gray-600 dark:text-gray-300">
      Estamos trabajando duro para traerte esta sección. ¡Vuelve pronto para ver
      las novedades!
    </p>

    <a
      href="/"
      class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-orange-500 to-red-600 p-0.5 font-medium text-gray-900 focus:outline-none focus:ring-4 focus:ring-orange-200 group-hover:from-orange-500 group-hover:to-red-600 dark:text-white dark:focus:ring-orange-800"
    >
      <span
        class="relative rounded-full bg-white px-8 py-3 transition-all duration-75 ease-in group-hover:bg-opacity-0 dark:bg-gray-900"
      >
        Volver al Inicio
      </span>
    </a>
  </main>

  <Footer />

</Layout>
